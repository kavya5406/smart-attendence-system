# Smart Attendance System - environment configuration
# Copy to .env and adjust. Every path is resolved relative to the project root,
# so the same file works on macOS, Windows and Linux.

# ---------------------------------------------------------------- backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Public origin of the deployed app. Used for CORS and documentation links.
# Must be https:// in production: the browser camera requires a secure context.
FRONTEND_URL=https://example.onrender.com
CORS_ORIGINS=https://example.onrender.com

# -------------------------------------------------------------- frontend ---
# Leave empty when the frontend is served by the backend (recommended).
# The API is mounted under /api, so the client appends it automatically.
VITE_API_URL=

# Dev-server proxy target for `npm run dev`.
VITE_BACKEND_URL=http://localhost:8000

# --------------------------------------------------------------- dataset ---
# Root folder holding one sub-folder per student id.
# Face images are personal data: this folder is git-ignored and never pushed.
DATASET_PATH=./data/raw
PROCESSED_PATH=./data/processed

# ----------------------------------------------------------------- model ---
# Paths to the existing trained artifacts (used as-is, never retrained here).
MODEL_PATH=./models/best_model.pkl
SCALER_PATH=./models/scaler.pkl
FEATURE_SELECTOR_PATH=./models/feature_selector.pkl
LABEL_ENCODER_PATH=./models/best_model_label_encoder.pkl

# --------------------------------------------------------------- database ---
# SQLite by default. For PostgreSQL use e.g.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/attendance
DATABASE_URL=sqlite:///./data/database/attendance.db

# ----------------------------------------------------------- verification ---
# Cosine-similarity threshold in the raw 1805-dim scaled feature space.
# Above 0.08 a face must reach this value against a registered identity before
# attendance is recorded. See models/verification_metrics.json for the
# measurement this value was chosen from.
RECOGNITION_THRESHOLD=0.08

# ----------------------------------------------------------------- extras ---
CONFIG_PATH=./config/config.yaml
FRONTEND_DIST=./frontend/dist

# Optional experiment tracking (MLflow). Unset to disable.
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_ENABLED=false
